<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="#0D0D0D" android:padding="32dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="📞 Входящий звонок" android:textColor="#FFFFFF"
        android:textSize="24sp" android:textStyle="bold" />

    <TextView android:id="@+id/callerIp" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="" android:textColor="#AAAAAA" android:textSize="18sp" />

    <Button android:id="@+id/btnAccept" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="48dp"
        android:text="Принять" android:textSize="18sp" android:backgroundTint="#2C5F2D" />

    <Button android:id="@+id/btnDecline" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="Отклонить" android:textSize="18sp" android:backgroundTint="#8B0000" />
</LinearLayout>

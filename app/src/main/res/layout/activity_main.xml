<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/z_bg">

    <LinearLayout android:id="@+id/discoveryView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="@color/z_surface"
            app:title="Zvon"
            app:titleTextColor="@color/z_text_primary" />

        <TextView android:id="@+id/statusText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:text="Готов"
            android:textColor="@color/z_text_secondary" android:textSize="13sp"
            android:background="@color/z_surface_alt" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiscover" style="@style/Z_Button_Primary"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="Поиск" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChats" style="@style/Z_Button_Primary"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:layout_height="wrap_content"
                android:text="Чаты" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnForceReset" style="@style/Z_Button_Danger"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:layout_height="wrap_content"
                android:text="Сброс" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout android:id="@+id/peerList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiles" style="@style/Z_Button_Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp" android:text="📁 Файлы" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifAccess" style="@style/Z_Button_Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp" android:text="🔔 Доступ к уведомлениям" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeerTest" style="@style/Z_Button_Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp" android:text="🧪 Тест с пиром" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelfTest" style="@style/Z_Button_Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp" android:text="🔍 Самодиагностика" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareLog" style="@style/Z_Button_Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="12dp" android:text="📤 Поделиться логом" />
    </LinearLayout>

    <LinearLayout android:id="@+id/callView" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center"
        android:background="@color/z_bg" android:padding="24dp">

        <TextView android:id="@+id/callStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Звонок"
            android:textColor="@color/z_text_primary" android:textSize="22sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/callPeer" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="" android:textColor="@color/z_text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/callDuration" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="00:00" android:textColor="@color/z_text_primary"
            android:textSize="48sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/callStats" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="" android:textColor="@color/z_text_secondary"
            android:textSize="10sp" android:fontFamily="monospace" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="40dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute" style="@style/Z_Button_Primary"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                android:text="🔇 Без звука" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeaker" style="@style/Z_Button_Primary"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="📞 Телефон" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHangup" style="@style/Z_Button_Danger"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Завершить" />
    </LinearLayout>
</FrameLayout>

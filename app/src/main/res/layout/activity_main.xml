<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="#0D0D0D">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zvon MVP" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
    <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Idle" android:textColor="#888888" android:textSize="14sp" />
    <Button android:id="@+id/btnLoopback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Start Loopback (FULL)" />
    <Button android:id="@+id/btnRaw" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Start Raw Codec Test" />
</LinearLayout>
